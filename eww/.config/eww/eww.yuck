      ;   )
      ; "
    )
    
  ; )
)
(defvar focus_control_center false)
(defvar control_center_size 300)
(defwidget control_center []
(eventbox
    ; :class "base"
    ; :style "background-color: black;"
    :onhoverlost "eww close bar_extended && eww update focus_control_center='false'"
    (box
      :class "grid_dark"
      :width control_center_size
      (box
        :orientation "v"
        :valign "start"
        :halign "center"
        :space-evenly false
        ; :spacing {spacing}
        ; "control center"
        (player)
        (markdown)
      )
    )
  )
)
;;BAR extended
(defwindow bar_extended
 :monitor 0
 :geometry (geometry :x "40px"
                     :y "0"
                     ; :width "32px"
                     ; :width "20%"
                     :height "100%"
                     :anchor "center left")
 ; :windowtype "desktop"
 :reserve (struts :distance "32px" :side "left")
 :stacking "overlay"
 ; :exclusive true
 :namespace "eww_bar_extended"
  (control_center)
  
)

;;BAR
(defwindow bar 
 :monitor 0
 :geometry (geometry :x "0"
                     :y "0"
                     :width "32px"
                     ; :width "20%"
                     :height "100%"
                     :anchor "center left")
 ; :windowtype "desktop"
 :reserve (struts :distance "32px" :side "left")
 :stacking "fg"
 ; :exclusive true
 :namespace "eww_bar"
  (box
    (centerbox
      :orientation "v"
      :halign "center"
      :width 40 ; scss $main-bar-width
      :class "grid_dark"
      (box
        :valign "start"
        :orientation "v"
        :spacing {spacing}
        :space-evenly false
        :vexpand true
        (container
          (eventbox
            ; :onclick "eww open --toggle bar_extended && eww update focus_control_center='true'"
            :onclick "eww open --toggle bar_extended"
            :cursor "pointer"
            :class ""
            "󱔐"
          )
        )
        (clock)
        (volume_knob)
        (brightness_knob)
      )
      (box
        :valign "center"
        :orientation "v"
        :spacing {spacing}
        :space-evenly false
        (audio_vis :height 20 :width 3 :size wave_form :vert true)
        ; (stack
        ;   :selected {audio_vis_fade}
        ;   :transition "crossfade"
        ;   :same-size true
          ; (audio_vis :height 20 :width 3 :size "[50,30,50,80,60]" :vert true)
          ; (audio_vis :height 20 :width 3 :size "[20,50,40,60,70]" :vert true)
          ; (audio_vis :height 20 :width 3 :size "[30,80,30,50,40]" :vert true)
        ; )
      )
      (box
        :valign "end"
        :orientation "v"
        :spacing {spacing}
        :space-evenly false
        (stats)
        (apptray)
        (power_menu)
      )
    )
  )
)



;;DESKTOP
(defwidget backdrop []
  (box
    :class "backdrop"
    :space-evenly false
    ; :spacing {spacing}
    :orientation "h"
    :halign "end"
    :style "padding:0 0 0 40px;"
    (overlay
      (box
        :width {res_w}; the size of the display
        :height {res_h}
      )
      (box
        :orientation "h"
        :space-evenly false
        (revealer
          :reveal {focus_control_center}
          :transition "slideleft"
          (box
            :width control_center_size
          )
          ; (control_center)
        )
        (box
          :width {res_w - 40}; the size of the display
          :height {res_h}
          :halign "start"
          :class "wallpaper"
          :style `background: center no-repeat url("file://${wallpaper}"); background-size: cover; background-position: 0 ${wall_offset}px;`
        )
      )    
      (label
        ; :height 100
        :halign "center"
        :valign "center"
        :style "margin-top:500px;padding:10px;font-size:48px;font-weight:bold;"
        :class "main"
        :wrap true
        :wrap-mode "word"
        ; :text "FUCK YOU"
        :text "YOU HAVE NO IDEA WHAT'S GOING ON"
      )
    )
    
  )
)

(defwindow desktop
  :monitor 0
  :geometry (geometry :x "0%"
                     :y "0px"
                     :width "100%"
                     :height "100%"
                     :anchor "top center")
  :stacking "bg"
  :windowtype "desktop"
  :exclusive false
  :namespace "eww_backdrop"
  :focusable false
  (backdrop)
)
