(defvar backdrop_visible false)

(deflisten wallpaper
	:initial "ok"
`tail -Fn1 /home/olrak/.config/eww/.eww_wallpaper`)

(defwindow backdrop []
	:namespace "wallpaper"
	:monitor 0
	:stacking "bg"
	; :windowtype "dock"
	; :reserve (struts :distance "60px" :side "left")
	; :exclusive "true"
	:geometry (geometry 
		; :x {gap != "" ? gap : 10}
		:x "0%"
		; :y "14px"
		:y "0%"
		:height "100%"
		:width "100%"
		:anchor "top left"
	)
	(box
		:visible {backdrop_visible == true? false : true}
		:class {backdrop_visible == true? "out" : "in"}
		(overlay
			(box
				:class "backdrop_back"
				; :onhoverlost "niri msg action toggle-overview"
				; :style "background-color: blue;"
			)
			(box
				; :style {screen_width == "2560"? "background:center no-repeat url('${wallpaper}');background-size:cover;background-position: center -1200px;margin-right:${sides}px;": "background:center no-repeat url('${wallpaper}');background-size: 102%;background-position: -30px;margin-right:${sides}px;background-color:white;"} 
				:style "
					background:center no-repeat url('${wallpaper}');
					background-size:cover;
					background-position: center;
					margin:4px;
				"
				:class "wallpaper"
			)
		)
	)
)
