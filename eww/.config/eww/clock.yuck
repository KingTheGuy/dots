(defvar devider "󰇘")
(defwidget clock [?orientation]
	(eventbox
		:onclick `notify-send "clock"`
		:class "container"
		:valign "center"
		(box
			:valign "center"
			:halign "center"
			; :space-evenly false
			:spacing -5
			:orientation "v"
			"${time[0]}"
			devider
			"${time[1]}"
			devider
			"${time[2]}"
		)
	)
)
