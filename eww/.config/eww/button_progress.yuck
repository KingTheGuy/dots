(defvar pro 30)
(defvar steps 2)
(defvar circle_thickness 4)
(defvar temp_icon_volume "󱄠")
(defpoll update_volume ;;will not work if not referenced
	; :interval "120ms"
	; :initial "0.00"
	:interval "280ms"
`./go/volume/main`)

(defwidget button_progress []
	(eventbox
		:class "container"
		:onscroll "eww update pro=$(./go/progress/main {} ${steps} ${pro})"
		:onclick "./bash/mute.sh 󰕾 󰝟"
		(overlay
			(progress_bar_flipped
				:value pro
				:icon temp_icon_volume
			)
			(box ;; runs / updates the volume
				:visible false
				"${update_volume}"
			)
		)
	)
)
