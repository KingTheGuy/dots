;;  PENGUIN
;;TODO:
; user input: will use a progress bar
; pc stats: will use a circular progress bar
; - [ ] add timer
; - [ ] notification center
; - [ ]
; - [ ] have DATE update on hover
; - [ ] have DAY update on click
(defvar res_w 1600)
(defvar res_h 900)

(defvar spacing 12)
(defvar spacing_sub 8)

(defvar show_apptray true)
;;APPTRAY
(defwidget apptray []
  (box
    :class "button"
    (box
      :orientation "v"
      :space-evenly false
      (revealer
        :reveal {show_apptray}
        :transition "slidedown"
        :duration "300ms"
        (systray
          :orientation "v"
          :icon-size 16
          :spacing {spacing_sub}
          :class "container"
        )
      )
      (eventbox
        :onclick './bash/toggle.sh show_apptray'
        :class "button"
        :tooltip "apptray"
        ; {show_apptray == true? "󱊔":"󱊖"}
        (label
          :xalign 0.4
          :text {show_apptray == true? "󱊔":"󱊖"}
        )
        
      )
    )
  )
)


;;BRIGHNESS
(defpoll brightness
  :interval "100ms"
  :initial "00"
  "light -G"
)
(defvar reveal_brightness_knob
  "false"
)
(defwidget brightness_knob []
  (eventbox
    :onscroll `bash/brightness_knob.sh {}`
    ; :onclick  `wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle`
    :onhover `eww update reveal_brightness_knob="true"`
    :onhoverlost `eww update reveal_brightness_knob="false"`
    :cursor "pointer"
    :class "button"
    (box
      :orientation "v"
      :space-evenly false
      :spacing {reveal_brightness_knob == "false"? 0:spacing_sub}
      :class "container"
      ; {volume_muted == ""? "󰕾":"󰖁"}
      "󰃟"
      (revealer
        :reveal {reveal_brightness_knob}
        :transition "slidedown"
        :duration "300ms"
        (box
          :orientation "v"
          :space-evenly false
          :spacing {spacing_sub}
          ;;FIXME: should make it so that no rounding is done within the progressbar
          (progressbar :max_height 40 :value {brightness})
          {brightness == ''? "00":brightness>= 99? 99 : round(brightness,0)}
        )
      )
    )
  )
)

;;CONPONENTS
(defwidget progressbar [max_height ?width value ?in_value ?urgent]
  (box
    :orientation "v"
    :class "progressbar"
    :space-evenly false
    (overlay
      (box
        :halign "center"
        :valign "end"
        :width {width == ''? spacing: width}
        :height max_height
        ; :height {round((value/100)*max_height,0) > max_height? round((value/100)*max_height,0):max_height}
        :class "base"
        ; :class "grid"
      )
      (box
        :halign "center"
        :valign "end"
        :width {width == ''? spacing: width}
        ; :height {round((round((value * max_height),0)/max_height) * max_height,0)}
        ; :class "value ${round(value*100,0) > 75? "urgent":""}"
        :height {round((value/100)*max_height,0) > max_height?max_height:round((value/100)*max_height,0)}
        :class "value ${round((value/100)*100,0) > 75? "urgent":""}"
        ; :style "border-radius:0;"
      )
      ; (box ;; grid overlay
      ;   :halign "center"
      ;   :valign "end"
      ;   :width {width == ''? spacing: width}
      ;   :height max_height
      ;   ; :height {round((value/100)*max_height,0) > max_height? round((value/100)*max_height,0):max_height}
      ;   :class "grid"
      ;   :style "background-size: ${max_height/5}px ${max_height/5}px"
      ; )

      (label
        :valign "end"
        :halign "center"
        :visible {in_value == ""? false:true}
        ; :class "value ${round(value*100,0) > 75? "urgent":""}"
        ; :style "font-size:9px; opacity:${round(value*100,0) >= 75? round(value,0):0}; background:none;"
        ; :text {round(value*100,0) >= 99? 99:round(value*100,0)}
        ; 
        :class "value ${value > 75? "urgent":""}"
        ; :style "font-size:${value > 99?6:9}px; opacity:${round((value/100)*100,0) >= 75? round(value,0):0}; background:none;"
        :style "font-size:${value > 99?6:9}px; background:none;"
        :text {value}
      )
    )
  )
)

;;POWER
(defwidget power_menu []
  (eventbox
    ; :halign "center"
    :valign "center"
    :cursor "pointer"
    :class "button"
    (box
      :class "container"
      "⏼"
    )
  )
)

;;STATS
(defvar cir_thic 4)
(defwidget stat [value icon tooltip]
  (box
    :orientation "v"
    :space-evenly true
    ; :valign "end"
    :halign "center"
    ; :class "button container"
    :spacing {spacing_sub/2}
    :tooltip tooltip
    ; (progressbar :max_height 22 :width 14 :value {value} :in_value true)
    (progressbar :max_height 22 :value {value} :in_value true)
    ; (overlay
    ;   (circular-progress
    ;     :thickness {cir_thic}
    ;     :start-at 75
    ;     :value value
    ;   )
    ;   (circular-progress
    ;     :thickness {cir_thic}
    ;     :style "opacity:0.2;"
    ;     :value 100
    ;   )
    ; )
    icon
  )
)
(defvar show_stats true)
(defwidget stats []
  (box
    :orientation "v"
    :space-evenly false
    :spacing {show_stats == "false"? 0:spacing_sub}
    ; :spacing {spacing_sub}
    :tooltip "stats"
    :class "button container"
    ; :style "background-color:red;"
    (revealer
      :reveal {show_stats}
      :transition "slidedown"
      :duration "300ms"
      (box
        :orientation "v"
        :space-evenly false
        :spacing {spacing / 2}
        (stat :value {round(EWW_TEMPS.CORETEMP_CORE_0,0)} :icon "󰈸" :tooltip "[${round(EWW_TEMPS.CORETEMP_CORE_0,0)}] cpu_temp")
        "‑‑"
        (stat :value {round(EWW_CPU.avg,0)} :icon "󰻠" :tooltip "[${round(EWW_CPU.avg,0)}] cpu")
        (stat :value {round(EWW_DISK["/"].used_perc,0)} :icon "" :tooltip "[${round(EWW_DISK["/"].used_perc,0)}] disk")
        (stat :value {round(EWW_RAM.used_mem_perc,0)} :icon "󰚌" :tooltip "[${round(EWW_RAM.used_mem_perc,0)}] ram")
      )
    )
    (eventbox
      :class "button"
      :onclick `bash/toggle.sh show_stats`
      :cursor "pointer"
      ; {show_stats == "true"? "":""}
      {show_stats == "true"? "":"-"}
    )
  )
)

;;VOLUME
(defpoll volume
  :interval "100ms"
  :initial "00"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d ' ' -f2"
)
(defpoll volume_muted
  :interval "100ms"
  :initial "00"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d ' ' -f3"
)

(defvar reveal_knob
  "false"
)
(defwidget volume_knob [?override]
  (eventbox
    :onscroll `bash/volume_knob.sh {}`
    :onclick  `wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle`
    :onhover `eww update reveal_knob="true"`
    :onhoverlost `eww update reveal_knob="false"`
    :cursor "pointer"
    :class "button"
    (box
      :orientation "v"
      :space-evenly false
      :spacing {reveal_knob == "false"? 0:spacing_sub}
      :class "container"
      {volume_muted == ""? "󰕾":"󰖁"}
      (revealer
        :reveal {reveal_knob == true || override == true? true:false}
        :transition "slidedown"
        :duration "300ms"
        (box
          :orientation "v"
          :space-evenly false
          :spacing {spacing_sub}
          (progressbar :max_height 40 :value {round(volume*100,0)})
          ; (progress
          ;   :flipped true
          ;   :halign "center"
          ;   :valign "start"
          ;   :orientation "v"
          ;   :height 1
          ;   :value {round(volume * 100,0)}
          ;   :style "min-width:${spacing}px;"
          ; )
          (label
            :valign "end"
            :halign "center"
            ; :class "value ${round(value*100,0) > 75? "urgent":""}"
            ; :style "font-size:9px; opacity:${round(value*100,0) >= 75? round(value,0):0}; background:none;"
            ; :text {round(value*100,0) >= 99? 99:round(value*100,0)}
            ; 
            :style "${round(volume*100,0) > 99?"font-size:10px;":""}"
            :text {round(volume*100,0)}
          )
          ; {volume == ''? "00":volume * 100 > 99? 99 : round(volume * 100,0)}
        )
      )
    )
  )
)

;;CLOCK/TIME
(defpoll time_hour
  :interval "1s"
  :initial "00"
  "date +%I"
)
(defpoll time_min
  :interval "1s"
  :initial "00"
  "date +%M"
)
(defpoll time_sec
  :interval "1s"
  :initial "00"
  "date +%S"
)
(defpoll time_am_pm
  :interval "1s"
  :initial "00"
  "date +%p"
)
(defpoll date_mon
  :interval "1s"
  :initial "00"
  ; `echo "[$(date +%m,%d,%Y)]"`
  "date +%m"
)
(defpoll date_day
  :interval "1s"
  :initial "00"
  ; `echo "[$(date +%m,%d,%Y)]"`
  "date +%d"
)
(defpoll date_year
  :interval "1s"
  :initial "00"
  ; `echo "[$(date +%m,%d,%Y)]"`
  "date +%Y | tail -c3"
)
(defvar clock_show ;; what to be showing in the main clock
  0
)
(defwidget clock []
  (eventbox
    :onhover 'eww update clock_show="1"'
    :onhoverlost 'eww update clock_show="0"'
    :cursor "pointer"
    :class "button"
    (box
      :orientation "v"
      :space-evenly false
      :spacing {spacing_sub}
      :class "container"
      (stack
        :selected {clock_show}
        :transition {clock_show == 0? "slideleft":"slideright"} ;; slidedown crossfade slideleft
        (box ;;time
          :orientation "v"
          :halign "center"
          :valign "start"
          :space-evenly false
          :spacing {spacing_sub}
          (box
            :halign "center"
            :valign "start"
            :orientation "v"
            {time_hour}
            "··"
            {time_min}
            "··"
            {time_sec}
          )
          {time_am_pm}
          ; ""
        )
        (box ;;date
          :orientation "v"
          :halign "center"
          :valign "start"
          :space-evenly false
          :spacing {spacing_sub}
          (box
            :halign "center"
            :valign "start"
            :orientation "v"
            {date_mon}
            "‑‑"
            {date_day}
            "‑‑"
            {date_year}
          )
          ""
        )
      )
    )
  )
)


;;POPUP
(defwindow popup [?override]
  :monitor 0
  :geometry (geometry :x "4px"
                     :y "0px"
                     :width "32px"
                     ; :width "20%"
                     :height "10px"
                     :anchor "center left")
  ; :reserve (struts :distance "33px" :side "left")
  :stacking "overlay"
  :focusable "none"
  :namespace "eww_popup"
  (box
    :class "main"
    (volume_knob :override true)
  )
)

;;BAR
(defwindow bar 
 :monitor 0
 :geometry (geometry :x "0%"
                     :y "0px"
                     :width "32px"
                     ; :width "20%"
                     :height "100%"
                     :anchor "top left")
 ; :windowtype "desktop"
 :reserve (struts :distance "33px" :side "left")
 :stacking "fg"
 :namespace "eww_bar"
  (centerbox
    :orientation "v"
    :class "bar"
    :width 40 ; scss $main-bar-width
    ; :spacing {spacing}
    :orientation "v"
    (box
      ; :halign "start"
      :valign "start"
      :orientation "v"
      :spacing {spacing}
      :space-evenly false
      (clock)
      (volume_knob)
      (brightness_knob)
    )
    (box
      :valign "center"
      :orientation "v"
      :spacing {spacing}
      :space-evenly false
    )
    ; (progressbar :max_height 30 :value {volume})
    (box
      :valign "end"
      :orientation "v"
      :spacing {spacing}
      :space-evenly false
      (stats)
      (apptray)
      (power_menu)
    )
  )
)



;;DESKTOP
(defwidget backdrop []
  (box
    :class "backdrop"
    (box
      :width {res_w}; the size of the display
      :height {res_h}
      :halign "start"
      :class "wallpaper"
    )
  )
)
(defwindow desktop
 :monitor 0
 :geometry (geometry :x "0%"
                     :y "0px"
                     :width "100%"
                     :height "100%"
                     :anchor "top center")
 :stacking "bg"
 :windowtype "desktop"
 ; :wm-ignore false
 :namespace "eww_backdrop"
  (backdrop)
)
