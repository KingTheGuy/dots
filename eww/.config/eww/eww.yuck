(defvar bar_width 30)
(defvar spacing 5)
(defpoll time
	:interval "2s"
	:initial '[ "00", "00", "00" ]'
; `date +%r | jq -R 'split(":")'`)
`date +%T | jq -R 'split(":")'`)

(include "./backdrop.yuck")
(include "./clock.yuck")
(include "./components.yuck")
(include "./battery.yuck")
(include "./temp.yuck")
(include "./button_progress.yuck")
(include "./backlight.yuck")
(include "./ram.yuck")


(defwindow bar []
	; :namespace "bar"
	:monitor 0
	:stacking "fg"
	; :windowtype "dock"
	; :reserve (struts :distance "60px" :side "left")
	:exclusive "false"
	:geometry (geometry 
		; :x {gap != "" ? gap : 10}
		:x 10
		; :y "14px"
		:y "0%"
		:height "97.8%"
		; :width "0px"
		:anchor "left center"
	)

	(overlay
		(eventbox
			:onclick "niri msg action toggle-overview"
			; :onscroll "
			; bash -c '
			; 	if [[ {} == 'up' ]]; then
			; 		niri msg action focus-workspace-up
			; 	else
			; 		niri msg action focus-workspace-down
			; 	fi
			; '"
			:halign "center"
			:width {bar_width * 1.3}
			:class "main_bar"
		; :style "background-color: yellow;"
		)
		(centerbox
			:orientation "v"
			:halign "center"
			:width bar_width
			:class "main_bar"
			(box
				:valign "start"
				:orientation "v"
				:space-evenly false
				:spacing spacing
				(clock)
				(box
					:class "container"
					:orientation "v"
					:space-evenly false
					:spacing spacing
					(button_progress)
					"--"
					(backlight)
				)
			)
			(box
				:valign "center"
				:orientation "v"
				:space-evenly false
				:spacing spacing
				; "eat shit"
			)
			(box
				:valign "end"
				:orientation "v"
				:space-evenly false
				:spacing spacing
				(temp)
				(ram)
				(battery)
			)
		)
	)
)
