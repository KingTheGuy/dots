(defwindow popup [?override]
  :monitor 0
  :geometry (geometry :x "6px"
                     :y "0px"
                     ; :width "32px"
                     :height "10px"
                     :anchor "center left")
  ; :reserve (struts :distance "33px" :side "left")
  :stacking "overlay"
  :namespace "eww_popup"
  ; (box
  ; (container
    (literal
      :class "main"
      :content override
      ; :content "
      ;   (box
      ;   (audio_vis :height 20 :width 3 :size wave_form :vert true)
