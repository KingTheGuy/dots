;;DISPLAY RES
; (defpoll res
;   :interval "60s"
; `nu -c 'wlr-randr | find current | split column " " | get column5 | split column "x" | to json -r'`)
(defvar res_w 1600)
(defvar res_h 900)
(defvar wall_offset "-200")

;;WALLPAPER dir
(defpoll wallpaper
  :interval "60m"
`tail -n1 /$HOME/.eww_wallpaper`)

;;COMPONENTS
(defvar spacing 10)
(defvar spacing_sub 8)

(defwidget container [?orientation ?onclick ?onscroll ?onhover ?onhoverlost ?cursor ?style ?class]
  (eventbox
    :halign "center"
    :valign "center"
    :width 26
    :height 26
    :hexpand false
    :vexpand false
    :class "container ${class}"
    ; :class {class == ""? "":class}
    :onclick {onclick == ""?"":onclick}
    :onscroll {onscroll == ""?"":onscroll}
    :onhover {onhover == ""?"":onhover}
    :onhoverlost {onhoverlost == ""?"":onhoverlost}
    :cursor {cursor == ""?"default":cursor}
    :style {style == ""?"":style}
    (box
      :style "padding:4px;"
      :orientation {orientation == ''?"h":"v"}
      (children)
    )
  )
)
; (defpoll loaded_json
;   :interval "1s"
;   './go/context/main | jq'
; )
; (defwidget json_text [?json]
;   (box
;     ; :orientation "v"
;     ; "${json}"
;     ; (for word in {loaded_json}
;     ;   "${word}"
;     ; )
;     "nothing"
;   )
; )
;;LAUCNHER ;; rename this
(defvar context "")
(defvar content "")
(defvar notes "")
(defvar show_content false)
(defwindow launcher
  :monitor 0
  :geometry (geometry :x "0%"
                     :y "35%"
                     :width "0"
                     :height "0"
                     :anchor "center top")
  :stacking "overlay"
  :focusable "ondemand"
  (box
    :orientation "v"
    :space-evenly false
    :spacing {spacing}
    :style "border-radius:8px; padding:10px;"
    :class "main"
    :width 500
    (input
      ; :width 400
      ; :value ":h"
      :onchange "./go/launcher/main {}"
      :class "main input"
      :style "border-radius:8px;"
    )
    (revealer
      :transition "slidedown"
      :duration "200ms"
      :reveal {show_content}
      (scroll
        :height 200
        (box
          :orientation "v"
          :space-evenly false
          ; (box ;; NOTES STUFF
          ;   :orientation "v"
          ;   :space-evenly false
          ;   :spacing {spacing_sub}
          ;   "STUFF:"
          ;   ; (json_text)
          ;   (for note in notes
          ;     (label
          ;       :halign "start"
          ;       :valign "start"
          ;       :wrap-mode "word"
          ;       :wrap true
          ;       :text "${note.data_text}"
          ;     )
          ;   )
          ; )
          (box
            (literal
              :content content
            )
          )
        )
      )
    )
  )
)

;;PLAYER
(defvar album_art "")
(defvar album_art_current "")
(defvar album_art_blurred "")
; (defpoll audio_playing
;   :interval "300ms"
;   :initial "Paused"
; `playerctl status`)
; (defvar wave_form "[50,30,50,80,60]")
(defwidget player []
  (container
    (box
      :orientation "h"
      :space-evenly false
      :spacing {spacing}
      :class "main"
      :style "padding:6px;"
      (box
        :orientation "v"
        :valign "end"
        :height 140
        :width 240
        :style `background: center no-repeat url("${album_art_blurred}"); background-size: 180%; background-position: center; border-radius:8px; padding: ${spacing}px;`
        :space-evenly false
        :spacing {spacing}
        (box
          :halign "center"
          :valign "center"
          :orientation "h"
          :space-evenly true
          :spacing {spacing}
          (box
            :width 80
            :height 80
            :style `background: center no-repeat url("${album_art}"); background-size: cover; background-position: center; border-radius:6px; padding: 2px;`
          )
          (box
            :valign "center"
            :halign "start"
            :orientation "v"
            :space-evenly false
            :spacing {spacing_sub/2}
            (label
              :halign "start"
              :style "font-weight:bold;"
              :text "song title"
            )
            (label
              :halign "start"
              :style "font-size:12px;"
              :text "artist"
            )
          )
        )
        (box
          :halign "center"
          :valign "end"
          :space-evenly false
          :spacing {spacing*2}
          (container
            :onclick "playerctl previous"
            "󰙣"
          )
          (container
            :onclick "playerctl play-pause"
            {album_art == ""?"󰐌":"󰏥"}
            
          )
          (container
            :onclick "playerctl next"
            "󰙡"
          )
        )
        ; "player"
        ; {album_art}
      )
      (volume_knob :override true)
    )
  )
)
(defvar wave_form "[50,30,50,80,60]")
(defvar audio_vis_fade 0)
(defwidget audio_vis [height width size ?vert]
  (container
    :onclick "playerctl play-pause"
    (box
      :orientation "v"
      :space-evenly false
      :halign "center"
      :valign "center"
      :spacing {spacing_sub/2}
      ; (box
      ;   ; :width 60
      ;   :visible {album_art == ""? false:true}
      ;   :height 80
      ;   :style `background: center no-repeat url("${album_art}"); background-size: cover; background-position: center; border-radius:8px;`
      ; )
      :style `background: center no-repeat url("${album_art_blurred}"); background-size: cover; background-position: center; border-radius:8px; padding: 2px;`
      (box
        :orientation {vert == ''?"h":"v"}
        :halign "center"
        :valign "center"
        :space-evenly false
        :spacing 5
        ; :class "base"
        :style "padding:${spacing_sub/2}px 0;"
        (for bar in size
          (overlay
            (box
              :halign "center"
              :valign "center"
              :height {vert == ''?height:width}
              :width {vert == ''?width:height}
              ; :class "base"
              ; :style "background-color:black;"
            )
            (box
              :halign "center"
              :valign "center"
              :height {vert == ''?round((bar/100)*height,0) > height?height:round((bar/100)*height,0):width}
              ; :width width
              :width {vert == ''?width:round((bar/100)*height,0) > height?height:round((bar/100)*height,0)}
              :class "value"
            )
          )
        )
      )
      "󱛟"
    )
  )
)

;;APPTRAY
(defvar show_apptray false)
(defwidget apptray []
  (eventbox
    :onhover `eww update show_apptray='true'`
    :onhoverlost `eww update show_apptray='false'`
    (container
      (box
        :orientation "v"
        :space-evenly false
        (revealer
          :reveal {show_apptray}
          :transition "slidedown"
          :duration "300ms"
          (systray
            :orientation "v"
            :icon-size 16
            :spacing {spacing_sub}
          )
        )
        (eventbox
          :onclick 'bash/toggle.sh show_apptray'
          ; :class "button"
          :tooltip "apptray"
          ; {show_apptray == true? "󱊔":"󱊖"}
            (label
              :text {show_apptray == true? "󱊔":"󱊖"}
            )
      
        )
      )
    )
  )
)


;;BRIGHNESS
(deflisten brightness
  ; :interval "100ms"
  :initial "00"
  ; "light -G"
  `tail -F /tmp/eww_brightness`
)
(defvar reveal_brightness_knob
  "false"
)
(defwidget brightness_knob []
  (container
    :onscroll `bash/brightness_knob.sh {}`
    ; :onclick  `wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle`
    :onhover `eww update reveal_brightness_knob="true"`
    :onhoverlost `eww update reveal_brightness_knob="false"`
    :cursor "pointer"
    (box
      :orientation "v"
      :space-evenly false
      :spacing {reveal_brightness_knob == "false"? 0:spacing_sub}
      ; {volume_muted == ""? "󰕾":"󰖁"}
      ; "󰃟"
      ; "󰤝"
      ; "󰐜" for keyboard brightness
      ; "󰖧"
      "󰖧"
      (revealer
        :reveal {reveal_brightness_knob}
        :transition "slidedown"
        :duration "300ms"
        (box
          :orientation "v"
          :space-evenly false
          :spacing {spacing_sub}
          ;;FIXME: should make it so that no rounding is done within the progressbar
          (progressbar :max_height 40 :value {brightness})
          {brightness == ''? "00":brightness>= 99? 99 : round(brightness,0)}
        )
      )
    )
  )
)

;;CONPONENTS
(defwidget progressbar [max_height ?width value ?in_value ?urgent ?alt]
  (box
    :orientation "v"
    :class "progressbar"
    :space-evenly false
    (overlay
      (box
        :halign "center"
        :valign "end"
        :width {width == ''? 12: width}
        :height max_height
        ; :height {round((value/100)*max_height,0) > max_height? round((value/100)*max_height,0):max_height}
        :class "base"
        ; :class "grid"
      )
      (box
        :halign "center"
        :valign "end"
        :width {width == ''? 12: width}
        ; :height {round((round((value * max_height),0)/max_height) * max_height,0)}
        ; :class "value ${round(value*100,0) > 75? "urgent":""}"
        :height {round((value/100)*max_height,0) > max_height?max_height:round((value/100)*max_height,0)}
        ;;FIXME:  this is not working how i'd want it to (same for label)
        ; :class "value ${urgent == ''?'':'${round((value/100)*100,0) > urgent? 'urgent':''}'}"
        :class {alt == ""? "value ${urgent == ''?'':'${round((value/100)*100,0) > urgent? 'urgent':''}'}" :"grid_fade"}
      )
      ; (box ;; grid overlay
      ;   :halign "center"
      ;   :valign "end"
      ;   :width {width == ''? spacing: width}
      ;   :height max_height
      ;   ; :height {round((value/100)*max_height,0) > max_height? round((value/100)*max_height,0):max_height}
      ;   :class "grid"
      ;   :style "background-size: ${max_height/5}px ${max_height/5}px"
      ; )

      (label
        :valign "end"
        :halign "center"
        :visible {in_value == ""? false:true}
        ; :class "value ${round(value*100,0) > 75? "urgent":""}"
        ; :style "font-size:9px; opacity:${round(value*100,0) >= 75? round(value,0):0}; background:none;"
        ; :text {round(value*100,0) >= 99? 99:round(value*100,0)}
        ; 
        :class 'value ${urgent == ''?'':'${round((value/100)*100,0) > urgent? 'urgent':''}'}'
        :style "margin:2px 0px;font-size:12px; opacity:${round((value/100)*100,0) >= 60? 1:0}; background:none;"
        ; :style "font-size:${value > 99?6:9}px; background:none;"
        :angle 90
        :text {value}
      )
    )
  )
)

;;POWER
(defwidget power_menu []
  (container
    (eventbox
      ; :halign "center"
      :valign "center"
      :cursor "pointer"
      ; :class "button"
      (box
        ; :class "container"
        ; "⏻"
        :class "howdy"
        ""
      )
    )
  )
)

;;STATS
(defvar cir_thic 4)
(defwidget stat [value icon tooltip]
  (box
    :orientation "v"
    :space-evenly true
    ; :valign "end"
    :halign "center"
    ; :class "button true"
    :spacing {spacing_sub/2}
    :tooltip tooltip
    ; (progressbar :max_height 22 :width 14 :value {value} :in_value true)
    (progressbar :max_height 22 :value {value} :in_value true :urgent 85)
    ; (overlay
    ;   (circular-progress
    ;     :thickness {cir_thic}
    ;     :start-at 75
    ;     :value value
    ;   )
    ;   (circular-progress
    ;     :thickness {cir_thic}
    ;     :style "opacity:0.2;"
    ;     :value 100
    ;   )
    ; )
    icon
  )
)
(defvar show_stats true)
(defwidget stats []
  (container
    (eventbox
      :onclick `bash/toggle.sh show_stats`
      :cursor "pointer"
      (box
        :orientation "v"
        :space-evenly false
        ; :spacing {show_stats == "false"? 0:spacing_sub}
        ; :spacing {spacing_sub}
        ; :class "button container"
        ; :style "background-color:red;"
        (revealer
          :reveal {show_stats}
          :transition "slidedown"
          :duration "300ms"
          (box
            :orientation "v"
            :space-evenly false
            :spacing {spacing / 2}
            :style "margin:${spacing_sub}px 0px;"
            (stat :value {round(EWW_TEMPS.CORETEMP_CORE_0,0)} :icon "󰈸" :tooltip "[${round(EWW_TEMPS.CORETEMP_CORE_0,0)}] cpu_temp" :urgent 20)
            "‑‑"
            (stat :value {round(EWW_CPU.avg,0)} :icon "󰻠" :tooltip "[${round(EWW_CPU.avg,0)}] cpu")
            (stat :value {round(EWW_DISK["/"].used_perc,0)} :icon "󰨆" :tooltip "[${round(EWW_DISK["/"].used_perc,0)}] disk")
            ; "󰨅"
            ; "󰟜"
            (stat :value {round(EWW_RAM.used_mem_perc,0)} :icon "󰚌" :tooltip "[${round(EWW_RAM.used_mem_perc,0)}] ram")
          )
        )
        (eventbox
          ; {show_stats == "true"? "":""}
          ; {show_stats == "true"? "":"-"}
          :class "base"
          :tooltip "stats"
          :style "${show_stats == true?'border-radius:2px 2px 8px 8px;':'border-radius:8px;'}"
          "󰍛"
        )
      )
    )
  )
)

;;VOLUME
(deflisten volume
  ; :interval "1s"
  :initial "00"
  `tail -F /tmp/eww_volume`
  ; "wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d ' ' -f2"
  ; have get volume/ update volume be this
  ; setting the volume will be done externally
  ; "eww get volume && wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d ' ' -f2"
)
(defpoll volume_muted
  :interval "500ms"
  :initial "00"
  "wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d ' ' -f3"
)

(defvar reveal_knob
  "false"
)
(defwidget volume_knob [?override]
  (container
    ; :onscroll `bash/volume_knob.sh {}`
    :onscroll `lua lua/volume_knob.lua {} scroll`
    :onclick `lua lua/volume_knob.lua mute`
    ; :onclick  `wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle`
    :onhover {override != ""?"":`eww update reveal_knob="true"`}
    :onhoverlost `eww update reveal_knob="false"`
    :cursor "pointer"
    ; :style {album_art == ""?"":"background-color:yellow;"}
    :class {volume_muted == ""?"":"${album_art == ""?"":"notice"}"}
      ; :class "button"
    (box
      :orientation "v"
      :space-evenly false
      :spacing {reveal_knob == "false"? 0:spacing_sub}
      ; :class "container"
      ; {volume_muted == ""? "󰕾":"󰖁"}
      (stack
        :selected {volume_muted == ""? 0:1}
        :transition {volume_muted == ""? "slideright":"slideleft"}  ;; slidedown crossfade slideleft
        :same-size true
        "󰕾"
        "󰖁"
      )
      (revealer
        :reveal {reveal_knob == true || override == true? true:false}
        :transition "slidedown"
        :duration "300ms"
        (box
          :orientation "v"
          :space-evenly false
          :spacing {spacing_sub}
          ; (scale
          ;   :orientation "v"
          ;   :value {round(volume*100,0)}
          ;   :style "trough{background-color:red;color:blue;}"
          ; )
          (progressbar :max_height 40 :value {round(volume*100,0)} :alt volume_muted)
          ; (progress
          ;   :flipped true
          ;   :halign "center"
          ;   :valign "start"
          ;   :orientation "v"
          ;   :height 1
          ;   :value {round(volume * 100,0)}
          ;   :style "min-width:${spacing}px;"
          ; )
          (label
            :valign "center"
            :halign "center"
            ; :text {round(value*100,0) >= 99? 99:round(value*100,0)}
            ; 
            ; :style "${round(volume*100,0) > 99?"font-size:8.5px;":""}"
            :angle {round(volume*100,0) > 99?90:0}
            :text {round(volume*100,0)}
            ; :text {round(volume*100,0) > 99?"${round(volume*100,0) > 110?"":"0"}${round(volume*100,0)-100}":round(volume*100,0)}
          )
          ; {volume == ''? "00":volume * 100 > 99? 99 : round(volume * 100,0)}
        )
      )
    )
  )
)

;;CLOCK/TIME
(defpoll time_full
  :interval "1s"
  :initial `["00","00","00"]`
  ; `date +%I:%M:%S |  jq -Rc 'split(":")'`
  `date +%H:%M:%S |  jq -Rc 'split(":")'`
)
(defvar date_full
  ; :interval "60s"
  ; :initial `["00","00","00"]`
  ; `date +%m:%d:%g |  jq -Rc 'split(":")'`
  `["00","00","00"]`
)
(defvar clock_show ;; what to be showing in the main clock
  0
)
(defwidget clock []
  (container
    :onhover `eww update clock_show="1" && eww update date_full="$(date +%m:%d:%g |  jq -Rc 'split(":")')"`
    :onhoverlost 'eww update clock_show="0"'
    :cursor "pointer"
    (box
      :orientation "v"
      :space-evenly false
      :spacing {spacing_sub}
      ; :class "container"
      (stack
        :selected {clock_show}
        :transition {clock_show == 0? "slideleft":"slideright"} ;; slidedown crossfade slideleft
        :same-size true
        (box ;;time
          :orientation "v"
          :halign "center"
          :valign "start"
          :space-evenly false
          :spacing {spacing_sub}
          (box
            :halign "center"
            :valign "start"
            :orientation "v"
            {time_full[0]}
            ; {time_hour}
            "··"
            {time_full[1]}
            ; {time_min}
            "··"
            {time_full[2]}
            ; {time_sec}
          )
          ; {time_am_pm}
          ; ""
        )
        (box ;;date
          :orientation "v"
          :halign "center"
          :valign "start"
          :space-evenly false
          :spacing {spacing_sub}
          (box
            :halign "center"
            :valign "start"
            :orientation "v"
            {date_full[0]}
            "‑‑"
            {date_full[1]}
            "‑‑"
            {date_full[2]}
          )
          ; ""
          ; "󱪹"
        )
      )
    )
  )
)


